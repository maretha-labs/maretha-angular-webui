{
  "name": "maretha-angular-webui",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maretha-labs/maretha-angular-webui.git"
  },
  "homepage": "https://github.com/maretha-labs/maretha-angular-webui#readme",
  "bugs": {
    "url": "https://github.com/maretha-labs/maretha-angular-webui/issues"
  },
  "scripts": {
    "build:sdk": "ng-packagr -p app/extensions/ng-package.json -c tsconfig.sdk.json",
    "pack:sdk": "npm run build:sdk && npm pack ./dist/webui-sdk --pack-destination dist",
    "package:nuxeo": "node scripts/nuxeo-package.mjs",
    "verify:nuxeo-package": "node --test scripts/nuxeo-package.test.mjs",
    "verify:licenses": "node --test scripts/verify-licenses.test.mjs && node scripts/verify-licenses.mjs",
    "verify:release-identity": "node --test scripts/release-identity.test.mjs && node scripts/release-identity.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --aot",
    "build:sourcemaps": "ng build --configuration production --output-path=localSourceMaps",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --max-warnings=0",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "verify:test-apps": "node scripts/verify-test-apps.mjs",
    "new:contribution": "node scripts/custom/new-contribution.mjs",
    "new:layout": "node scripts/custom/new-layout.mjs",
    "verify:custom-guards": "node --test scripts/custom/scaffold.test.mjs scripts/eslint/custom-boundaries.test.mjs scripts/eslint/no-credential-default.test.mjs scripts/core-manifest.test.mjs scripts/verify.test.mjs scripts/agent-guides/pointers.test.mjs",
    "verify:custom-scaffold": "node scripts/custom/verify-scaffold.mjs --prove-failures",
    "verify:examples": "node --test scripts/verify-examples.test.mjs && node scripts/verify-examples.mjs --prove-failures",
    "verify": "node scripts/verify.mjs",
    "verify:upstream": "node scripts/verify.mjs --upstream",
    "verify:release": "node scripts/verify.mjs --release",
    "verify:public-tree": "node --test scripts/public-tree.test.mjs",
    "verify:release-artifacts": "node --test scripts/release-artifacts.test.mjs && node scripts/release-artifacts.mjs",
    "release:core-manifest": "node scripts/core-manifest.mjs",
    "release:files": "node --test scripts/release-files.test.mjs && node scripts/release-files.mjs",
    "verify:core-manifest": "node scripts/core-manifest.mjs --check",
    "inventory:polymer-slots": "node scripts/parity/polymer-slots.mjs",
    "render:polymer-parity": "node scripts/parity/render-parity.mjs",
    "verify:polymer-parity": "node --test scripts/parity/polymer-map.test.mjs && node scripts/parity/render-parity.mjs --check",
    "render:slot-catalog": "node scripts/agent-guides/slot-catalog.mjs",
    "verify:slot-catalog": "node --test scripts/agent-guides/slot-catalog.test.mjs && node scripts/agent-guides/slot-catalog.mjs --check",
    "verify:results-projection-template-context": "node scripts/verify-results-projection-template-context.mjs",
    "prepare": "husky",
    "preview": "ng serve --configuration preview --host 127.0.0.1 --port 4300 --open=false",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --progress=false",
    "verify:sdk-consumer": "node scripts/verify-sdk-consumer.mjs",
    "verify:sdk-api": "node scripts/check-sdk-api.mjs",
    "update:sdk-api": "node scripts/check-sdk-api.mjs --update",
    "verify:sdk-ids": "node scripts/check-sdk-ids.mjs",
    "update:sdk-ids": "node scripts/check-sdk-ids.mjs --update",
    "verify:sdk-upgrade": "node scripts/verify-sdk-upgrade.mjs",
    "verify:sdk-check-failures": "node scripts/verify-sdk-check-failures.mjs",
    "verify:transfer-contract": "node scripts/verify-transfer-contract.mjs",
    "verify:transfer-check-failures": "node scripts/verify-transfer-contract.mjs --prove-failures",
    "measure:pdf-ranges": "node scripts/measure-pdf-ranges.mjs",
    "test:coverage": "node scripts/collect-coverage.mjs",
    "verify:coverage": "node scripts/verify-coverage.mjs",
    "verify:coverage-guard": "node --test scripts/verify-coverage.test.mjs scripts/verify-coverage.integration.test.mjs",
    "update:coverage-baseline": "node scripts/verify-coverage.mjs --update",
    "test:e2e:compiled-search": "playwright test -c e2e/playwright.compiled-search.config.ts",
    "test:a11y": "node e2e/a11y/run.mjs",
    "verify:a11y-guards": "node --test e2e/a11y/reviewed-findings.test.mjs e2e/a11y/report-summary.test.mjs e2e/a11y/run.test.mjs e2e/local-boundary.test.mjs",
    "test:e2e:nuxeo": "playwright test -c e2e/playwright.nuxeo.config.ts",
    "prepare:e2e:nuxeo": "node e2e/nuxeo/prepare-state.mjs",
    "verify:nuxeo-state": "node --test e2e/nuxeo/prepared-session.test.mjs",
    "i18n:inventory": "node scripts/i18n/source-inventory.mjs",
    "verify:i18n": "node scripts/i18n/verify.mjs",
    "verify:i18n-guards": "node --test scripts/i18n/guards.test.mjs scripts/i18n/cli-guards.test.mjs scripts/i18n/migrate-static.test.mjs e2e/i18n/pseudo-audit.test.mjs scripts/i18n/complete-catalogs.test.mjs scripts/i18n/source-references.test.mjs",
    "i18n:pseudo": "node scripts/i18n/pseudo.mjs",
    "test:i18n": "npm run i18n:pseudo && playwright test -c e2e/playwright.i18n.config.ts && node e2e/i18n/summarize.mjs",
    "verify:compiled-search-production": "node scripts/verify-compiled-search-production.mjs"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "{scripts,e2e,.github}/**/*.{mjs,cjs}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{json,md,scss,css,yaml,yml}": "prettier --check"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.2.0",
    "@angular/animations": "21.2.25",
    "@angular/cdk": "^21.2.8",
    "@angular/cdk-experimental": "^21.2.8",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@babel/runtime": "^7.22.15",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.1.1",
    "@fortawesome/free-brands-svg-icons": "^6.1.1",
    "@fortawesome/free-regular-svg-icons": "^6.1.1",
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@google/model-viewer": "^3.1.1",
    "@larscom/ngx-translate-module-loader": "^3.1.1",
    "@messageformat/core": "^3.0.1",
    "@ng-select/ng-select": "^21.8.0",
    "@ngx-translate/core": "^17.0.0",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "bootstrap": "^5.3.0",
    "chart.js": "^4.3.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "fast-deep-equal": "^3.1.3",
    "intl-messageformat": "^10.5.0",
    "marked": "^17.0.6",
    "ng2-charts": "^10.0.0",
    "ngx-autosize": "^2.0.4",
    "ngx-bootstrap": "^21.2.0",
    "ngx-doc-viewer": "^14.0.0",
    "ngx-drag-to-select": "^5.0.1",
    "ngx-extended-pdf-viewer": "^25.6.4",
    "ngx-json-viewer": "^3.2.1",
    "ngx-markdown": "^21.2.0",
    "ngx-progressbar": "^14.0.0",
    "ngx-timeago": "^4.1.0",
    "ngx-toastr": "^19.0.0",
    "ngx-translate-cut": "^21.1.0",
    "ngx-translate-formatjs-compiler": "^1.0.8",
    "prismjs": "^1.29.0",
    "rxjs": "~7.5.0",
    "three": "^0.163.0",
    "ts-cacheable": "^1.0.9",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "~3.10.0",
    "@types/marked": "^4.0.8",
    "@types/node": "^12.11.1",
    "@types/three": "^0.163.0",
    "accessibility-checker-engine": "4.0.34",
    "ajv": "8.18.0",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jasmine-core": "~4.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "lint-staged": "^16.4.0",
    "ng-packagr": "21.2.7",
    "prettier": "^3.8.3",
    "spdx-expression-parse": "4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "webpack": "^5.100.2",
    "zone.js": "^0.15.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
