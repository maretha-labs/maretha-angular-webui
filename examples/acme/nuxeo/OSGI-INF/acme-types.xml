<?xml version="1.0"?>
<!-- Defines the Contract and Invoice types that examples/acme/custom expects on a test server.
     Contract uses the same "contract" schema as examples/contract; install one of the two
     fixtures, not both. -->
<component name="io.maretha.webui.examples.acme">
 <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
  <schema name="contract" prefix="contract" src="schemas/contract.xsd"/>
  <schema name="invoice" prefix="invoice" src="schemas/invoice.xsd"/>
 </extension>
 <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
  <doctype name="Contract" extends="File"><schema name="contract"/></doctype>
  <doctype name="Invoice" extends="File"><schema name="invoice"/></doctype>
 </extension>
 <extension target="org.nuxeo.ecm.platform.types.TypeService" point="types">
  <type id="Contract"><label>Contract</label><icon>/icons/file.gif</icon><default-view>view_documents</default-view></type>
  <type id="Invoice"><label>Invoice</label><icon>/icons/file.gif</icon><default-view>view_documents</default-view></type>
  <type id="Workspace"><subtypes><type>Contract</type><type>Invoice</type></subtypes></type>
  <type id="Folder"><subtypes><type>Contract</type><type>Invoice</type></subtypes></type>
 </extension>
</component>
