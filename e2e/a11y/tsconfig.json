{
  "extends": "../../tsconfig.json",
  "compilerOptions": { "outDir": "../../out-tsc/a11y", "types": [] },
  "files": ["main.ts", "../../polyfills.ts"],
  "include": ["../../**/*.d.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
