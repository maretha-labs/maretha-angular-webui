{
  "extends": "../tsconfig.json",
  "compilerOptions": { "outDir": "../out-tsc/preview", "types": [] },
  "files": ["main.ts", "../polyfills.ts"],
  "include": ["../**/*.d.ts"],
  "angularCompilerOptions": {
